<Window x:Class="FinovoTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finovo Global — Enterprise OS Login"
        Height="730" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="SubtleGlowEffect" BlurRadius="25" ShadowDepth="0" Color="#F95716" Opacity="0.25" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5" />
    </Window.Resources>

    <!-- Outer Window Frame -->
    <Border CornerRadius="16" Background="#080D1A" BorderBrush="#1C273F" BorderThickness="1.2">
        <Grid>
            <!-- Background Radial Glow -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#182A4D" Offset="0" />
                    <GradientStop Color="#0D1527" Offset="0.5" />
                    <GradientStop Color="#080D1A" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Draggable) -->
            <Grid Grid.Row="0" Margin="16,0,12,0" MouseDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Stylized Monogram Box -->
                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource BrushPrimaryGradient}">
                        <TextBlock Text="FG" FontWeight="Bold" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Finovo Global" FontWeight="Bold" FontSize="13.5" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,8,0" />
                    <Border CornerRadius="4" BorderBrush="#F95716" BorderThickness="1.2" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="PRISE OS" FontWeight="Bold" FontSize="8.5" Foreground="#F95716" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowCtrlBtnStyle}" Content="—" Click="OnMinimizeClicked" />
                    <Button Style="{StaticResource WindowCtrlBtnStyle}" Content="✕" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>

            <!-- 2. Main Login Card -->
            <Border Grid.Row="1" Margin="22,4,22,22" CornerRadius="16" Background="#0E162B" BorderBrush="#1E2D4A" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,20" HorizontalAlignment="Stretch">

                        <!-- Glowing Brand Monogram Logo -->
                        <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BrushPrimaryGradient}"
                                HorizontalAlignment="Center" Effect="{StaticResource SubtleGlowEffect}">
                            <TextBlock Text="FG" FontWeight="Bold" FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Finovo Global" FontWeight="Bold" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,10,0,2" />

                        <TextBlock Text="ENTERPRISE OS" FontWeight="Bold" FontSize="9.5" Foreground="#F95716"
                                   HorizontalAlignment="Center" />

                        <!-- Small Orange Divider Bar -->
                        <Border Width="30" Height="2.5" CornerRadius="1.2" Background="#F95716" HorizontalAlignment="Center" Margin="0,6,0,14" />

                        <TextBlock Text="Welcome back" FontWeight="Bold" FontSize="21" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />

                        <TextBlock Text="Sign in to your Finovo Global workspace account" FontSize="11" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />

                        <!-- Field 1: Work Email / Username -->
                        <TextBlock Text="USERNAME OR WORK EMAIL" FontWeight="SemiBold" FontSize="9" Foreground="#94A3B8" Margin="2,0,0,6" />
                        <Border Height="44" CornerRadius="8" Background="#080E1C" BorderBrush="#223250" BorderThickness="1">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- User Icon -->
                                <Path Grid.Column="0" Fill="#64748B" VerticalAlignment="Center"
                                      Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                      Stretch="Uniform" Width="14" Height="14" />
                                <TextBox x:Name="TxtEmail" Grid.Column="1" Margin="8,0,0,0" Background="Transparent" Foreground="White"
                                         CaretBrush="#F95716" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"
                                         Text="samaria.fatima80@finovo.global" />
                            </Grid>
                        </Border>

                        <!-- Field 2: Password -->
                        <TextBlock Text="PASSWORD" FontWeight="SemiBold" FontSize="9" Foreground="#94A3B8" Margin="2,14,0,6" />
                        <Border Height="44" CornerRadius="8" Background="#080E1C" BorderBrush="#223250" BorderThickness="1">
                            <Grid Margin="12,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <!-- Lock Icon -->
                                <Path Grid.Column="0" Fill="#64748B" VerticalAlignment="Center"
                                      Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                      Stretch="Uniform" Width="14" Height="14" />
                                <PasswordBox x:Name="TxtPassword" Grid.Column="1" Margin="8,0,0,0" Background="Transparent" Foreground="White"
                                             CaretBrush="#F95716" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"
                                             Password="Password123!" />
                                <TextBox x:Name="TxtPasswordVisible" Grid.Column="1" Margin="8,0,0,0" Background="Transparent" Foreground="White"
                                         CaretBrush="#F95716" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                                <Button Grid.Column="2" Content="👁" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                        FontSize="12" Cursor="Hand" Click="OnTogglePasswordVisibility" />
                            </Grid>
                        </Border>

                        <!-- Error / Status Message -->
                        <TextBlock x:Name="TxtStatus" Text="" Foreground="#EF4444" FontSize="11" Margin="0,10,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />

                        <!-- Action Button: Sign In -->
                        <Button x:Name="BtnSignIn" Style="{StaticResource PrimaryActionBtnStyle}"
                                Content="Sign In to Workspace  →" Height="46" Margin="0,14,0,12" Click="OnSignInClicked" />

                        <!-- DPAPI Indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Fill="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"
                                  Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                  Stretch="Uniform" Width="11" Height="11" />
                            <TextBlock Text="Secure session encrypted with Windows DPAPI" FontSize="10.5" Foreground="#64748B" />
                        </StackPanel>

                        <!-- Bottom Diagnostic Buttons -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="36" CornerRadius="8" Background="#0A1122" BorderBrush="#1E2D4A" BorderThickness="1">
                                <Button Content="🌐  Network" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnNetworkClicked" />
                            </Border>

                            <Border Grid.Column="2" Height="36" CornerRadius="8" Background="#0A1122" BorderBrush="#1E2D4A" BorderThickness="1">
                                <Button Content="📈  API Diagnostics" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnDiagnosticsClicked" />
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>

